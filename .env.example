BOT_TOKEN=your_telegram_bot_token_here
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/toefl-ads-bot
PORT=3000
ADMIN_CHAT_ID=your_telegram_chat_id_here
ADMIN_USERNAME=TOEFLadmint
ADMIN_PHONE=+998335246820
CHANNEL_USERNAME=toefltashkent1
WEBHOOK_URL=https://your-railway-app.railway.app

# Master Student Identity (../identity-service) — resolves a lead who shares
# their phone number into a company-wide Person (see identity-resolve.js).
# No-ops until both are set — safe to leave blank until identity-service has
# a real deployed URL.
IDENTITY_SERVICE_URL=
# Must match the "toefl-ads-bot:" entry in identity-service's own SERVICE_API_KEYS.
TOEFL_ADS_BOT_IDENTITY_API_KEY=

# Sales Automation Engine (../sales-engine) — captures this same lead into
# the CRM (source/campaign attribution, scoring, routing) — see
# sales-engine.js. No-ops until both are set.
SALES_ENGINE_URL=
# Must match the "toefl-ads-bot:" entry in sales-engine's own SERVICE_API_KEYS.
TOEFL_ADS_BOT_SALES_ENGINE_API_KEY=

# Content Intelligence Engine (../content-intelligence-engine) — records a
# real person-level touch (DM_STARTED) the moment an ad deep link is opened,
# tagged with this bot's own adId as campaignId — see content-intelligence.js.
# No-ops until both are set.
CONTENT_INTELLIGENCE_ENGINE_URL=
# Must match the "toefl-ads-bot:" entry in content-intelligence-engine's own SERVICE_API_KEYS.
TOEFL_ADS_BOT_CONTENT_INTELLIGENCE_API_KEY=
